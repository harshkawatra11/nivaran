{
  "name": "nvidia-hackathon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "spike": "tsx --env-file=.env.local scripts/spike.ts",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "nightly": "tsx --env-file=.env.local scripts/nightly.ts",
    "eval": "tsx --env-file=.env.local eval/run.ts",
    "build:job": "node scripts/build-job.mjs",
    "verify": "npm run typecheck && npm run test && npm run build",
    "test:e2e": "playwright test",
    "demo:docs": "node scripts/make-demo-docs.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "clsx": "^2.1.1",
    "fontkit": "^2.0.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "pdf-lib": "^1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/fontkit": "^2.0.9",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
